with t3:
    st.header("📊 السجل")
    from src.tools import _load_json
    data = _load_json("measurements.json")
    if not data:
        st.info("📭 لا قياسات")
    else:
        ws, ss = [], []
        for dt in sorted(data.keys(), reverse=True):
            st.markdown(f"**📅 {dt}**")
            for e in data[dt]:
                line = f"• {e.get('time','')} — "
                if e.get("weight"):
                    line += f"`{e['weight']}kg` "
                    ws.append(e["weight"])
                if e.get("bp"):
                    line += f"`{e['bp']}`"
                    if "/" in e["bp"]:
                        try: ss.append(int(e["bp"].split("/")[0]))
                        except: pass
                st.write(line)
        st.divider()
        if len(ws) >= 2:
            c1, c2, c3 = st.columns(3)
            c1.metric("أول", f"{ws[0]:.1f}kg")
            c2.metric("آخر", f"{ws[-1]:.1f}kg")
