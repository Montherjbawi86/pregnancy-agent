# ==================== Popup ثنائي المرحلة ====================
@st.dialog("🛠️ أمينة", width="large")
def tool_popup():
    tool_name = st.session_state.get("popup_tool", "")
    tool_q = st.session_state.get("popup_question", "")
    stage = st.session_state.get("popup_stage", "input")
    answer = st.session_state.get("popup_answer", "")

    # ---------- الترويسة الملونة ----------
    if stage == "input":
        bg = "linear-gradient(135deg, #e91e63 0%, #9c27b0 100%)"
        subtitle = "عدّلي السؤال ثم أرسلي"
        icon = "✏️"
    else:
        bg = "linear-gradient(135deg, #4caf50 0%, #2196f3 100%)"
        subtitle = "إجابة أمينة"
        icon = "💬"

    st.markdown(f"""
    <div style="background: {bg};
                padding: 20px; border-radius: 12px; color: white; margin-bottom: 15px;">
        <h2 style="margin: 0; color: white;">{icon} {tool_name}</h2>
        <p style="margin: 5px 0 0 0; opacity: 0.95;">{subtitle}</p>
    </div>
    """, unsafe_allow_html=True)

    # ---------- المرحلة 1: إدخال السؤال ----------
    if stage == "input":
        edited = st.text_area(
            "✏️ السؤال:",
            value=tool_q,
            height=100,
            key="popup_text_area_v2"
        )

        col1, col2 = st.columns(2)
        with col1:
            if st.button("✉️ إرسال", type="primary", use_container_width=True, key="popup_send_v2"):
                if edited.strip():
                    question = edited.strip()
                    # أضف رسالة المستخدم للـ history
                    st.session_state.messages.append({"role": "user", "content": question})
                    # نفّذ الوكيل الآن
                    with st.spinner("🤰 أمينة تفكر..."):
                        try:
                            from src.agent import run_agent
                            answer_text, tools_used = run_agent(st.session_state.messages)
                        except Exception as e:
                            err = str(e)
                            if "429" in err or "Rate limit" in err or "rate_limit" in err:
                                answer_text = "⏳ عذراً، وصلنا للحد اليومي من الطلبات المجانية.\n\nمن فضلك انتظري 10-15 دقيقة ثم حاولي مرة أخرى.\n\n💡 نصيحة: قللي عدد الأسئلة المتتالية."
                                tools_used = []
                            else:
                                answer_text = f"⚠️ حدث خطأ: {err[:200]}"
                                tools_used = []
                    st.session_state.messages.append({"role": "assistant", "content": answer_text})
                    # خزّن الإجابة
                    st.session_state.popup_answer = answer_text
                    st.session_state.popup_tools_used = tools_used
                    st.session_state.popup_stage = "answer"
                    st.rerun()
        with col2:
            if st.button("❌ إلغاء", use_container_width=True, key="popup_cancel_v2"):
                st.session_state.popup_tool = None
                st.session_state.popup_question = None
                st.session_state.popup_stage = "input"
                st.session_state.popup_answer = ""
                st.rerun()

    # ---------- المرحلة 2: عرض الإجابة ----------
    else:
        # عرض السؤال الأصلي
        with st.expander("📝 السؤال", expanded=False):
            last_user_msg = ""
            for m in reversed(st.session_state.messages):
                role = m.get("role") if isinstance(m, dict) else getattr(m, "role", "")
                if role == "user":
                    last_user_msg = m.get("content") if isinstance(m, dict) else getattr(m, "content", "")
                    break
            st.write(last_user_msg)

        # عرض الأدوات المستخدمة
        tools_used = st.session_state.get("popup_tools_used", [])
        if tools_used:
            with st.expander(f"🔧 الأدوات المستخدمة ({len(tools_used)})", expanded=False):
                for t in tools_used:
                    st.markdown(f"**{t['name']}**")
                    st.code(str(t['result'])[:500], language="json")

        # عرض الإجابة
        st.markdown(f"""
        <div style="background: #f8f9fa; border-left: 4px solid #9c27b0;
                    padding: 15px 20px; border-radius: 8px; margin: 10px 0;">
            <div style="white-space: pre-wrap; font-size: 15px; line-height: 1.7;">
{answer}
            </div>
        </div>
        """, unsafe_allow_html=True)

        st.divider()

        # أزرار التحكم
        col1, col2, col3 = st.columns(3)
        with col1:
            if st.button("🔄 سؤال جديد", use_container_width=True, key="popup_new_v2"):
                st.session_state.popup_stage = "input"
                st.session_state.popup_answer = ""
                st.rerun()
        with col2:
            if st.button("💾 نسخ الإجابة", use_container_width=True, key="popup_copy_v2"):
                st.success("✅ تم النسخ (Ctrl+C)")
        with col3:
            if st.button("❌ إغلاق", type="primary", use_container_width=True, key="popup_close_v2"):
                st.session_state.popup_tool = None
                st.session_state.popup_question = None
                st.session_state.popup_stage = "input"
                st.session_state.popup_answer = ""
                st.rerun()


