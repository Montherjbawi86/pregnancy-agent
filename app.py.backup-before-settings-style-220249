with tab5:
    st.markdown("## 🎯 أهدافك الصحية")
    st.caption("تتبعي تقدمك اليومي")

    from data.goals import GOALS
    from datetime import datetime

    today = datetime.now().strftime("%Y-%m-%d")
    if "goals_progress" not in st.session_state:
