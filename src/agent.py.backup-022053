def run_agent(messages, max_steps: int = 10, tool_callback=None):
    """ينفذ دوراً واحداً من المحادثة"""
    tools_used = []
    for step in range(max_steps):
        r = client.chat.completions.create(
            model="openai/gpt-oss-120b",
            messages=messages,
            tools=TOOLS_DEFINITIONS,
            tool_choice="auto"
        )
        msg = r.choices[0].message
        messages.append(msg)

        if not msg.tool_calls:
            return msg.content, tools_used

        for tc in msg.tool_calls:
            name = tc.function.name
            args = json.loads(tc.function.arguments) if tc.function.arguments else {}
            try:
                result = AVAILABLE_TOOLS[name](**args)
            except Exception as e:
                result = f"خطأ في تنفيذ الأداة: {e}"
            tools_used.append({"name": name, "args": args, "result": result})
            if tool_callback:
                tool_callback(name, args, result)
            messages.append({"role": "tool", "tool_call_id": tc.id, "content": str(result)})

    return "⚠️ وصلت للحد الأقصى من المحاولات", tools_used
