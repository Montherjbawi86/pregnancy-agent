@st.dialog("🛠️ أداة أمينة", width="large")
def tool_popup():
    tool_name = st.session_state.get("popup_tool", "")
    tool_q = st.session_state.get("popup_question", "")
    stage = st.session_state.get("popup_stage", "input")
    answer = st.session_state.get("popup_answer", "")

    if stage == "input":
        bg = "linear-gradient(135deg, #e91e63 0%, #9c27b0 100%)"
        subtitle = "عدّلي السؤال ثم أرسلي"
        icon = "✏️"
    else:
        bg = "linear-gradient(135deg, #4caf50 0%, #2196f3 100%)"
        subtitle = "إجابة أمينة"
        icon = "💬"

    st.markdown(f"""
    <div style="background: {bg}; padding: 24px 28px; border-radius: 20px; color: white;
                margin-bottom: 20px; box-shadow: 0 12px 32px rgba(0,0,0,0.15);">
        <h2 style="margin: 0; color: white !important; font-size: 1.6em;">{icon} {tool_name}</h2>
        <p style="margin: 8px 0 0 0; opacity: 0.95; font-size: 1em;">{subtitle}</p>
    </div>
    """, unsafe_allow_html=True)

    if stage == "input":
        edited = st.text_area("✏️ السؤال:", value=tool_q, height=100, key="popup_text_v4")
        st.write("")
        col1, col2 = st.columns(2)
        with col1:
            if st.button("✉️ إرسال", type="primary", use_container_width=True, key="popup_send_v4"):
                if edited.strip():
                    question = edited.strip()
                    st.session_state.messages.append({"role": "user", "content": question})
                    with st.spinner("🤰 أمينة تفكر..."):
                        try:
                            answer_text, tools_used = run_agent(st.session_state.messages)
                        except Exception as e:
                            err = str(e)
                            if "429" in err or "Rate limit" in err:
                                answer_text = "⏳ عذراً، وصلنا للحد اليومي المجاني.\n\nانتظري 10-15 دقيقة ثم حاولي مرة أخرى."
                            else:
                                answer_text = f"⚠️ خطأ: {err[:200]}"
                            tools_used = []
                    st.session_state.messages.append({"role": "assistant", "content": answer_text})
                    st.session_state.popup_answer = answer_text
                    st.session_state.popup_tools_used = tools_used
                    st.session_state.popup_stage = "answer"
                    st.rerun()
        with col2:
            if st.button("❌ إلغاء", use_container_width=True, key="popup_cancel_v4"):
                st.session_state.popup_tool = None
                st.session_state.popup_stage = "input"
                st.rerun()
    else:
        st.markdown(f"""
        <div style="background: #ffffff; border-right: 5px solid #9c27b0; padding: 22px 26px;
                    border-radius: 14px; margin: 10px 0; box-shadow: 0 4px 16px rgba(0,0,0,0.08);
                    font-size: 15px; line-height: 1.9; color: #1a1a2e; white-space: pre-wrap;">
{answer}
        </div>
        """, unsafe_allow_html=True)

        tools_used = st.session_state.get("popup_tools_used", [])
        if tools_used:
            with st.expander(f"🔧 الأدوات ({len(tools_used)})"):
                for t in tools_used:
                    st.markdown(f"**{t['name']}**")
                    st.code(str(t['result'])[:400])

        # زر الاستماع
        try:
            _audio = text_to_speech(answer)
            if _audio:
                st.markdown("**🔊 استمعي للرد:**")
                st.audio(_audio, format="audio/mp3")
        except Exception:
            pass

        st.write("")
        col1, col2, col3 = st.columns(3)
        with col1:
            if st.button("🔄 سؤال جديد", use_container_width=True, key="popup_new_v4"):
                st.session_state.popup_stage = "input"
                st.session_state.popup_answer = ""
                st.rerun()
        with col2:
            if st.button("💬 المحادثة", use_container_width=True, key="popup_open_v4"):
                st.session_state.popup_tool = None
                st.session_state.popup_stage = "input"
                st.rerun()
        with col3:
            if st.button("✅ إغلاق", type="primary", use_container_width=True, key="popup_close_v4"):
                st.session_state.popup_tool = None
                st.session_state.popup_stage = "input"
                st.rerun()


if st.session_state.get("popup_tool"):
    tool_popup()


